    {
      "name": "07 File upload and download",
      "item": [
        {
          "name": "Upload brochure [200]",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/api/events/1/brochure",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": "sample_brochure.pdf"
                }
              ]
            },
            "description": "In Body > form-data click the file field and choose a PDF, PNG or JPEG (max 5MB)."
          }
