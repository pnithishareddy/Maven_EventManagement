    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Expected status is read from the request name, e.g. 'Create venue [201]'",
          "const m = pm.info.requestName.match(/\\[(\\d{3})\\]/);",
          "if (m) {",
          "  pm.test('Status code is ' + m[1], function () { pm.response.to.have.status(parseInt(m[1], 10)); });",
          "}"
        ]
      }
    }
  ]
