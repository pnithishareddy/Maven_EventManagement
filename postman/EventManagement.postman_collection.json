{
  "info": {
    "name": "Event Management API v2",
    "description": "Import into Postman. Start the app first. Default login: admin/admin123 (collection auth).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "basic",
    "basic": [
      {
        "key": "username",
        "value": "{{adminUser}}",
        "type": "string"
      },
      {
        "key": "password",
        "value": "{{adminPass}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8081"
    },
    {
      "key": "adminUser",
      "value": "admin"
    },
    {
      "key": "adminPass",
      "value": "admin123"
    },
    {
      "key": "userUser",
      "value": "user"
    },
    {
      "key": "userPass",
      "value": "user123"
    }
  ],
  "item": [
    {
      "name": "01 Public (no login)",
      "item": [
        {
          "name": "Actuator health [200]",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/actuator/health",
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Actuator info [200]",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/actuator/info",
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "OpenAPI JSON [200]",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/v3/api-docs",
            "auth": {
              "type": "noauth"
            }
          }
        }
      ]
    },
